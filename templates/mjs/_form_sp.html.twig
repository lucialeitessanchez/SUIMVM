{% block mjs_form %}
<div class="container mt-3">
    {{ form_start(form) }}
    
    <div class="row">
        <div class="col-md-2">{{ form_row(form.mjs_1a) }}</div>
        <div class="col-md-3">{{ form_row(form.mjs_1b1) }}</div>
        <div class="col-md-3">{{ form_row(form.mjs_1b2) }}</div>
        <div class="col-md-2">{{ form_row(form.mjs_1b3) }}</div>
        <div class="col-md-2">{{ form_row(form.mjs_1b4) }}</div>
    </div>

    <div class="row">
        <div class="col-md-3">{{ form_row(form.mjs_1b5_a) }}</div>
        <div class="col-md-2">{{ form_row(form.mjs_1b5_b) }}</div>
        <div class="col-md-3">{{ form_row(form.mjs_1b5_c) }}</div>
    </div>

    <div class="row">
        <div class="col-md-2">{{ form_row(form.mjs_2a) }}</div>
        <div class="col-md-3">{{ form_row(form.mjs_2b) }}</div>
        <div class="col-md-3">{{ form_row(form.mjs_2b1) }}</div>
        <div class="col-md-2">{{ form_row(form.mjs_2b2) }}</div>
        <div class="col-md-2">{{ form_row(form.mjs_2b3) }}</div>
        <div class="col-md-2">{{ form_row(form.mjs_2b4) }}</div>
    </div>

    <div class="row">
        <div class="col-md-2">{{ form_row(form.mjs_3a) }}</div>
        <div class="col-md-3">{{ form_row(form.mjs_3b) }}</div>
        <div class="col-md-3">{{ form_row(form.mjs_3b1) }}</div>
        <div class="col-md-2">{{ form_row(form.mjs_4a) }}</div>
        <div class="col-md-4">{{ form_row(form.mjs_4b) }}</div>
    </div>

    <div class="row">
        <div class="col-md-3">{{ form_row(form.caso) }}</div>
        <div class="col-md-3">{{ form_row(form.fecha_carga) }}</div>
        <div class="col-md-3">{{ form_row(form.usuario_carga) }}</div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Guardar</button>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
