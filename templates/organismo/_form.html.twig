    <hr>
{{ form_start(form) }}
    <div class="row mb-3">
            <div class="col-md-6">
                {{ form_label(form.nombreOrganismo,null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_errors(form.nombreOrganismo) }}
                {{ form_widget(form.nombreOrganismo,{'attr': {'class': 'form-control'}}) }}
            </div>   
             <div class="col-md-6">
                {{ form_label(form.referente,null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_errors(form.referente) }}
                {{ form_widget(form.referente,{'attr': {'class': 'form-control'}}) }}
            </div>   
    </div>
    <div class="row mb-3">
            <div class="col-md-4">
                {{ form_label(form.domicilio,null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_errors(form.domicilio) }}
                {{ form_widget(form.domicilio,{'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="col-md-4">
                {{ form_label(form.telefono,null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_errors(form.telefono) }}
                {{ form_widget(form.telefono,{'attr': {'class': 'form-control'}}) }}
            </div>   
            <div class="col-md-4">
                {{ form_label(form.celular,null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_errors(form.celular) }}
                {{ form_widget(form.celular,{'attr': {'class': 'form-control'}}) }}
            </div> 
    </div>
    <div class="row mb-3">
            <div class="col-md-4">
                {{ form_label(form.email,null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_errors(form.email) }}
                {{ form_widget(form.email,{'attr': {'class': 'form-control'}}) }}
            </div> 
            <div class="col-md-4">
                {{ form_label(form.localidad, null, {'label_attr': {'class': 'form-label'}}) }}
                               {{ form_widget(form.localidad, {'attr': {'class': 'select2-autocomplete form-select'}}) }}
                {{ form_errors(form.localidad) }}
            </div>        
                <!-- Departamento -->
            <div class="col-md-4">
                    <label for="departamento" class="form-label">Departamento</label>
                    <input type="text" class="form-control" id="departamento" readonly="true">
            </div>
    </div>
    <div class="row mb-3">
            <div class="col-md-4">
                <label for="iniciador" class="form-label">¿Es organismo iniciador?</label>
                           
                    <div class="form-check form-switch">
                        {{ form_row(form.esIniciador, {'label_attr': {'class': 'form-label'}}) }}
                    </div>
            </div>    
    </div> 
   
    
     {% if modo != 'show' %}
        <div class="col-md-12 d-flex justify-content-end">
                <div class="btn-group d-flex justify-content-center" role="group" style="align-item:center">
                <button type="submit" class="btn  btn-outline-primary" style="background-color:blue;color:white">{{ button_label|default('Save') }}</button>
               &nbsp;&nbsp;&nbsp;
                <a href="{{ path('organismo_index') }}" class="btn btn-outline-secondary" style="background-color:black;color:white" >Cancelar</a>
                </div>
        </div>
   {% endif %}
{{ form_end(form) }}
</section>
