        window.localidadInfoTemplate = '{{ path('localidad_info', { id: 'PLACEHOLDER' }) }}';
    </script>
    <script src="{{ asset('js/dptoYmicroregion.js') }}"></script>
    <script src="{{ asset('js/localidad.js') }}"></script>
{% endblock %}