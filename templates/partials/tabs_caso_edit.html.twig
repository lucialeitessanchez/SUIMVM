        title="Centro de Asistencia Judicial">

          <span class="circle-letter"><h5>CAJ</h5></span>

          {% if caj is empty %}
            <i class="bi bi-plus-circle small-icon-overlay"></i>
          {% endif %}

      </a>
    {% endif %}

