  <link rel="stylesheet" href="{{ asset('css/style.css') }}">
   {% set organismo = app.user.idOrganismo %}

  <div class="circle-tabs d-flex justify-content-end flex-wrap gap-3 mt-3 mb-0" style="padding-right:9rem; ">

    <a href="{{ path('app_caso_edit', { idCaso: caso.idCaso }) }}"
       class="circle-tab {% if pestaña_activa == 'caso' %}active{% endif %}"
       
       title="Identificación de la víctima">
      <i class="bi bi-person-lines-fill"></i>
    </a>

    {% if organismo in [3,1] %}

      {% set ruta = caj is not empty 
          ? path('app_caj_edit', { idCaso: caso.idCaso }) 
          : path('caj_new', { idCaso: caso.idCaso }) 
      %}

