{% extends 'base.html.twig' %}

{% block title %}Nomenclador{% endblock %}

{% block body %}
<div class="container mt-4">

<div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">Nomenclador</h1>

        <a href="{{ path('app_index') }}" class="btn btn-primary">
           Volver
        </a>
    </div>


<table class="table">
     <thead>
        <tr>
            <th>Tipo</th>
           {# <th>Acciones</th>#}
        </tr>
    </thead>
     {% for tipo, items in agrupados %}
            <tr>
                <td>
                    <div class="dropdown">
                        <button class="btn btn-outline-primary dropdown-toggle w-100 text-start"
                                type="button"
                                data-bs-toggle="dropdown">
                            {{ tipo }}
                        </button>

                        <div class="dropdown-menu p-3" style="min-width: 350px;">

                            {# LISTADO DE VALORES #}
                            {% for n in items %}
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span>{{ n.valorNomenclador }}</span>

                                    <span>
                                        <a href="{{ path('app_nomenclador_edit', {id: n.idNomenclador}) }}"
                                           class="btn btn-sm btn-warning">✏</a>

                                        <a href="#"
                                            class="btn btn-sm btn-danger btn-delete"
                                            data-url="{{ path('app_nomenclador_delete', {id: n.idNomenclador}) }}">
                                            🗑
                                            </a>
                                    </span>
                                </div>
                            {% endfor %}

                            <hr>

                            {# AGREGAR NUEVO VALOR AL GRUPO #}
                            <a href="{{ path('app_nomenclador_new', {tipo: tipo}) }}"
                               class="btn btn-sm btn-success w-100">
                                + Agregar valor
                            </a>

                        </div>
                    </div>
                </td>

                
            </tr>
        {% endfor %}
    </tbody>
</table>
</div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}

    <script>
        document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', function (e) {
                e.preventDefault();

                const url = this.getAttribute('data-url');

                Swal.fire({
                    title: '¿Estás seguro?',
                    text: "No vas a poder deshacer esta acción",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = url;
                    }
                });
            });
        });
    </script>
{% endblock %}