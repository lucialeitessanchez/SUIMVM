{% extends 'base.html.twig' %}

{% block title %}Nomenclador{% endblock %}

{% block body %}
<div class="container mt-4">

<div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">Nomenclador</h1>

        <a href="{{ path('app_nomenclador_new') }}" class="btn btn-primary">
            + Nuevo 
        </a>
    </div>


<table class="table">
    <thead>
        <tr>
            <th>Tipo</th>
            <th>Valor</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        {% for n in nomencladores %}
            <tr>
                <td>{{ n.nomenclador }}</td>
                <td>{{ n.valorNomenclador }}</td>
                <td>
                    <a href="{{ path('app_nomenclador_edit', {id: n.idNomenclador}) }}" class="btn btn-sm btn-warning">Editar</a>
                    <a href="{{ path('app_nomenclador_delete', {id: n.idNomenclador}) }}" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>
</div>
{% endblock %}